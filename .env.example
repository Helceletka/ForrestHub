# ForrestHub Docker Compose configuration
# Copy to `.env` and adjust as needed: `cp .env.example .env`

# Host port published on the Docker host
FH_PUBLISH_PORT=4444

# Container-internal bind address and port
FH_HOST=0.0.0.0
FH_PORT=4444

# Public hostname shown in QR codes
FH_HOST_QR=fh.helceletka.cz

# Run with --server (disables Flask reloader). Empty = off, any value = on
FH_SERVER=1

# Extra raw CLI args appended to `python run.py`
FH_EXTRA_ARGS=

# Persistent data lives in Docker named volumes:
#   forresthub_data    -> /app/data (holds ForrestHub-data.json)
#   forresthub_logs    -> /app/ForrestHub-logs
#   forresthub_games   -> /app/ForrestHub-games
# Manage them via Portainer -> Volumes.
