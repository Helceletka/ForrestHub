# ForrestHub Docker Compose configuration
# Copy to `.env` and adjust as needed: `cp .env.example .env`

# Host port published on the Docker host
FH_PUBLISH_PORT=4444

# Container-internal bind address and port
FH_HOST=0.0.0.0
FH_PORT=4444

# Public hostname shown in QR codes
FH_HOST_QR=fh.helceletka.cz

# Run with --server (disables Flask reloader). Empty = off, any value = on
FH_SERVER=1

# Extra raw CLI args appended to `python run.py`
FH_EXTRA_ARGS=

# Persistent data lives in Docker named volumes:
#   forresthub_data      -> /app/data (holds ForrestHub-data.json)
#   forresthub_logs      -> /app/ForrestHub-logs
#   forresthub_games     -> /app/ForrestHub-games
#   code_server_config   -> /config (code-server settings + extensions)
# Manage them via Portainer -> Volumes.

# --- code-server (browser VS Code with access to all three volumes) ---
# Host port exposing the code-server web UI
CODE_SERVER_PUBLISH_PORT=8443
# User/group IDs used inside the container (run `id` on the host to match)
CODE_SERVER_PUID=1000
CODE_SERVER_PGID=100
CODE_SERVER_TZ=Europe/Prague
# Login password for the web UI. CHANGE THIS.
CODE_SERVER_PASSWORD=changeme
# Optional: password for `sudo` inside the code-server terminal
CODE_SERVER_SUDO_PASSWORD=
# Optional: subdomain-proxy domain (see linuxserver/code-server docs)
CODE_SERVER_PROXY_DOMAIN=
